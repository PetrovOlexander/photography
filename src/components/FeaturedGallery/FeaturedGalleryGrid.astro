---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

 import { getImage, Image } from "astro:assets";
import { type CollectionEntry } from "astro:content";

import "@fancyapps/ui/dist/fancybox/fancybox.css";

interface Props {
	featuredImages: CollectionEntry<"featuredImages">[];
}

const { featuredImages } = Astro.props as Props;

// Candidate render widths; never request larger than the source image.
const widthsFor = (srcWidth: number) => {
	const widths = [400, 800, 1200, 1600, 2000, 2400].filter((w) => w <= srcWidth);
	return widths.length ? widths : [srcWidth];
};

// The fancybox lightbox must NOT link to `image.src` (that serves the untouched
// full-resolution original). Instead generate a watermarked, size-capped derivative
// through the image service so the "open" view is protected too.
const LIGHTBOX_MAX = 2000;
const items = await Promise.all(
	featuredImages.flatMap((entry) =>
		entry.data.images.map(async (image) => ({
			title: entry.data.title,
			image,
			large: await getImage({
				src: image,
				width: Math.min(image.width, LIGHTBOX_MAX),
				format: "webp",
				quality: "high",
			}),
		})),
	),
);
---

<section class="justified-gallery" id="photoswipe">
	{
		items.map(({ title, image, large }) => (
			<a
				style={`--width: ${image.width}; --height: ${image.height};`}
				href={large.src}
				data-fancybox="gallery"
			>
				<Image
					class="rounded-smss"
					src={image}
					alt={title}
					widths={widthsFor(image.width)}
					sizes="(max-width: 768px) 100vw, 70vw"
					loading={"lazy"}
					draggable={false}
				/>
			</a>
		))
	}
</section>

<script>
	import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

	const options = {
		theme: "auto",
		Hash: false, //REALLY IMPORTANT OTHERWISE URL GETS CHANGED AND FANCYBOX STOPS WORKING DUE TO COMPONENT REFRESH
		mainStyle: {
			"--f-button-width": "44px",
			"--f-button-height": "44px",
			"--f-button-border-radius": "50%",
			"--f-toolbar-padding": "16px",
		},
		Carousel: {
			Arrows: false,
			Toolbar: {
				display: {
					left: [],
					middle: [],
					right: ["close"],
				},
			},
			transition: "slide",
		},
	};

	// astro:page-load fires after every view transition (and on initial load),
	// ensuring FancyBox is rebound whenever the homepage DOM is present.
	document.addEventListener("astro:page-load", () => {
		Fancybox.destroy();
		Fancybox.bind("[data-fancybox]", options);
	});
</script>
